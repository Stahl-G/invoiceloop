# InvoiceLoop 环境变量示例。复制为 .env 或直接 export 到 shell。
# 密钥只从环境变量读,绝不落盘进任何工件或仓库文件。

# DWS_API_KEY(必需):DWS 抽取服务的密钥,ingest/heldout 抽字段时调用。
# 向 DWS 服务提供方申请;不设则 ingest 只做本地 OCR,抽取缺失按宪章四阻断。
DWS_API_KEY=

# ANTHROPIC_API_KEY(可选):读图(vision)用的 Anthropic 密钥,
# 整页渲染 → 读图模型作答,建议只预填复核表单。
# 在 https://console.anthropic.com 创建;与下面 AUTH_TOKEN 二选一。
ANTHROPIC_API_KEY=

# ANTHROPIC_AUTH_TOKEN + ANTHROPIC_BASE_URL(可选):走代理/兼容层时的替代凭证,
# AUTH_TOKEN 代替 API_KEY,BASE_URL 指向你的代理端点(默认 https://api.anthropic.com)。
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

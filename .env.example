# InvoiceLoop 凭证示例。复制成 .env(已在 .gitignore 里),按需填:
#
#   cp .env.example .env && chmod 600 .env
#
# 取值顺序:进程环境 > 本项目 .env > ~/.config/invoiceloop/vision.env(旧,仍认)。
# 进程环境永远优先 —— 临时 export 的 key 不会被文件里的旧值悄悄盖掉。
# `invoiceloop doctor` 会报每项「有没有、来自哪里」,**永不回显值本身**;
# 值也不进 run 目录、bundle 或日志。
#
# 全部可留空:产品路径的 demo(demo / workbench / run / bundle / verify)
# 零 API,一个 key 都不需要。

# --- DWS 抽取(ingest --do-extract、工作台勾选「调用 DWS 抽取」)---
# 不设则 ingest 只做本地 OCR,抽取缺失按宪章四阻断(不是静默跳过)。
DWS_API_KEY=

# --- 签名封缄(invoiceloop seal,走 Nutrient /sign)---
# 不填则回退到 DWS_API_KEY。
NUTRIENT_API_KEY=

# --- 读图(invoiceloop vision)与顾问层(invoiceloop suggest)共用 ---
# 二者与 ANTHROPIC_AUTH_TOKEN 二选一;走代理时用 AUTH_TOKEN + BASE_URL。
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
# 默认 https://api.anthropic.com
ANTHROPIC_BASE_URL=
# 覆盖默认模型名(读图与 suggest 共用)
# ANTHROPIC_DEFAULT_SONNET_MODEL=

# --- 留出集批量抽取(研究路径 heldout;多 key 轮换,逗号分隔)---
# DWS_API_KEYS=

# --- Gemini / ADK Agent 编排层 ---
# 不设则 Agent 层不可用；产品路径（demo / workbench / run / bundle / verify）不需要。
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=

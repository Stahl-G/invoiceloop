  "cards": [
    {
      "dot": "cyan",
      "title": "What DWS does",
      "items": [
        "Carries the core extraction in both modes",
        "Confidence is grounding-only — the vendor confirms it means 'found on the page', not 'correct'",
        "So correctness signals are built on top, here"
      ]
    },
    {
      "dot": "emerald",
      "title": "What is verifiable",
      "items": [
        "extraction_present · field_wellformed · arithmetic_consistency",
        "citation_holds · cross_mode_agreement · visual_corroboration",
        "A check that could not run is blocking, never a pass"
      ]
    },
    {
      "dot": "rose",
      "title": "Where authority stops",
      "items": [
        "Models write drafts with no IDs and advisory reports",
        "Python assigns every ID and freezes the ledger",
        "Promotion needs Gate 2 plus a human signature",
        "Public deploy refuses all nine write routes"
      ]
    },
    {
      "dot": "amber",
      "title": "What leaves the system",
      "items": [
        "deliverable.json — one row per field with a status and a source",
        "Values come only from the frozen ledger and the adjudication ledger; the support matrix is never the value source",
        "A corrected field keeps the extracted claim, the machine verdict and the decision that changed it",
        "Documents released while a check could not run are marked released_with_caveats, never plain released"
      ]
    }
  ]
